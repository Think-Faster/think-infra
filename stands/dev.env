# ============================================================
# Настройки стенда dev. Только НЕсекретные значения — пароли лежат в Vault (secrets.conf).
# Читают scripts/deploy.sh и scripts/bootstrap-stand.sh.
# Переменная окружения с тем же именем имеет приоритет над файлом.
# ============================================================

# Каталог на сервере, куда выкатываются сервисы (по папке на сервис).
# Пользователь GitHub runner-а должен иметь в нём права на запись.
TF_INFRA_DIR=/home/user1/tf/think-prod

# ---------- postgree ----------

# PostgreSQL на хосте. 0.0.0.0 — как было на dev до переезда (порт открыт наружу),
# чтобы не сломать сервисы, которые подключаются по IP сервера. Закрыть: DB_BIND=127.0.0.1.
# Сервисы могут подключаться к tf-postgres:5432 внутри сети think-fast-net.
DB_BIND=0.0.0.0
DB_PORT=5432

# ---------- web-server ----------

DOMAIN=greefob.ru
LETSENCRYPT_EMAIL=grishavasilev62@gmail.com

DOCKER_NETWORK=think-fast-net

FRONTEND_HOST=tf-front
FRONTEND_PORT=80

AUTH_HOST=tf-auth
AUTH_PORT=8081

BFF_HOST=tf-bff
BFF_PORT=8080
