# ============================================================
# Настройки стенда prod. Только НЕсекретные значения — пароли лежат в Vault (secrets.conf).
# Читают scripts/deploy.sh и scripts/bootstrap-stand.sh.
# Переменная окружения с тем же именем имеет приоритет над файлом.
# ============================================================

# Каталог на сервере, куда выкатываются сервисы (по папке на сервис).
# Пользователь GitHub runner-а должен иметь в нём права на запись.
TF_INFRA_DIR=/opt/tf.infra

# ---------- postgree ----------

# Порт PostgreSQL на хосте
DB_PORT=5432

# ---------- web-server ----------

# TODO: домен и почта prod. Пока CHANGE_ME — web-server на prod не выкатывается.
DOMAIN=CHANGE_ME
LETSENCRYPT_EMAIL=CHANGE_ME

DOCKER_NETWORK=think-fast-net

FRONTEND_HOST=tf-front
FRONTEND_PORT=80

AUTH_HOST=tf-auth
AUTH_PORT=8081

BFF_HOST=tf-bff
BFF_PORT=8080
