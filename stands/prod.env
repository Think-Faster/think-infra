# ============================================================
# Настройки стенда prod. Только НЕсекретные значения — пароли лежат в Vault (secrets.conf).
# Читают scripts/deploy.sh и scripts/bootstrap-stand.sh.
# Переменная окружения с тем же именем имеет приоритет над файлом.
# ============================================================

# Каталог на сервере, куда выкатываются сервисы (по папке на сервис).
# На prod-сервере docker compose разрешён только внутри /srv/thinkfaster.
# Пользователь, от которого запускается bootstrap и работает GitHub runner, должен иметь права на запись.
TF_INFRA_DIR=/srv/thinkfaster/tf.infra

# ---------- postgree ----------

# Порт PostgreSQL на хосте
DB_PORT=5432

# ---------- web-server ----------

DOMAIN=thinkfaster.ru
LETSENCRYPT_EMAIL=alexandrkrasulya@gmail.com

DOCKER_NETWORK=think-fast-net

FRONTEND_HOST=tf-front
FRONTEND_PORT=80

AUTH_HOST=tf-auth
AUTH_PORT=8081

BFF_HOST=tf-bff
BFF_PORT=8080
