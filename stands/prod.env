# ============================================================
# Настройки стенда prod. Только НЕсекретные значения — пароли лежат в Vault (secrets.conf).
# Читают scripts/deploy.sh и scripts/bootstrap-stand.sh.
# Переменная окружения с тем же именем имеет приоритет над файлом.
# ============================================================

# Каталог на сервере, куда выкатываются сервисы (по папке на сервис).
# На prod-сервере docker compose разрешён только внутри /srv/thinkfaster.
# Пользователь, от которого запускается bootstrap и работает GitHub runner, должен иметь права на запись.
TF_INFRA_DIR=/srv/thinkfaster/tf.infra

# ---------- postgree ----------

# PostgreSQL на хосте — только для администрирования (pgAdmin через SSH-туннель).
# 127.0.0.1 — снаружи сервера база недоступна. 5432 на prod-сервере занят, поэтому 15432.
# Сервисы подключаются к tf-postgres:5432 внутри сети think-fast-net.
DB_BIND=127.0.0.1
DB_PORT=15432

# ---------- web-server ----------

DOMAIN=thinkfaster.ru

# nginx слушает только публичный адрес: 127.0.0.1:80 занят nginx другого проекта,
# 443 на адресе Tailscale — его же Grafana. 0.0.0.0 здесь не запустится.
WEB_BIND=45.87.41.186

# Другие имена сайта через запятую: попадают в сертификат и в server_name nginx.
DOMAIN_ALIASES=www.thinkfaster.ru
LETSENCRYPT_EMAIL=alexandrkrasulya@gmail.com

DOCKER_NETWORK=think-fast-net

FRONTEND_HOST=tf-front
FRONTEND_PORT=80

AUTH_HOST=tf-auth
AUTH_PORT=8080

BFF_HOST=tf-bff
BFF_PORT=8080

# Воронка данных tf-funnel: /api/funnel/* (приём от шины, «Логи», WebSocket живых показаний).
FUNNEL_HOST=tf-funnel
FUNNEL_PORT=8000

# Кто может слать пакеты в POST /api/funnel/events: статический IP шины (адреса и подсети через запятую).
# Пусто — всем, защита только токеном. Заполнить, как только шина сообщит свой адрес.
FUNNEL_EVENTS_ALLOW=

# Веб-интерфейс Vault: https://<VAULT_DOMAIN>, вход по личному токену tf-admin (stands/dev.env).
# A-запись vault.thinkfaster.ru → 45.87.41.186 заведена (reg.ru, 28.09).
VAULT_DOMAIN=vault.thinkfaster.ru
VAULT_ALLOW=
