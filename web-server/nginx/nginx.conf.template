events {}

http {

    include /etc/nginx/mime.types;

    default_type application/octet-stream;

    # DNS Docker. Адреса сервисов ищутся при запросе, а не при старте:
    # nginx поднимается, даже если tf-front / tf-auth / tf-bff ещё не запущены
    # (для них вернётся 502), и видит новый IP после пересоздания контейнера.
    resolver 127.0.0.11 valid=10s ipv6=off;


    # ==================================================
    # HTTP
    # ==================================================

    server {

        listen 80;

        server_name ${SERVER_NAMES};


        # Let's Encrypt ACME challenge
        location /.well-known/acme-challenge/ {

            root /var/www/certbot;
        }


        # Everything else -> HTTPS
        location / {

            return 301 https://$host$request_uri;
        }
    }


    # ==================================================
    # HTTPS
    # ==================================================

    server {

        listen 443 ssl;

        server_name ${SERVER_NAMES};


        # --------------------------------------------------
        # TLS
        # --------------------------------------------------

        ssl_certificate
            /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;

        ssl_certificate_key
            /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;

        ssl_session_cache shared:SSL:10m;

        ssl_session_timeout 10m;


        # --------------------------------------------------
        # Authentication
        #
        # /api/auth/*
        #       ↓
        # ${AUTH_HOST}:${AUTH_PORT}
        # --------------------------------------------------

        location /api/auth/ {

            # Адрес в переменной — разрешается при запросе (см. resolver).
            # С переменной proxy_pass не отрезает префикс сам, поэтому rewrite.
            set $auth_upstream http://${AUTH_HOST}:${AUTH_PORT};

            rewrite ^/api/auth/(.*)$ /$1 break;

            proxy_pass $auth_upstream;

            proxy_http_version 1.1;

            proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # --------------------------------------------------
        # BFF
        #
        # /api/bff/*
        #       ↓
        # ${BFF_HOST}:${BFF_PORT}
        # --------------------------------------------------

        location /api/bff/ {

            set $bff_upstream http://${BFF_HOST}:${BFF_PORT};

            rewrite ^/api/bff/(.*)$ /$1 break;

            proxy_pass $bff_upstream;

            proxy_http_version 1.1;

            proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # --------------------------------------------------
        # Frontend
        #
        # /*
        #       ↓
        # ${FRONTEND_HOST}:${FRONTEND_PORT}
        # --------------------------------------------------

        location / {

            set $frontend_upstream http://${FRONTEND_HOST}:${FRONTEND_PORT};

            proxy_pass $frontend_upstream;

            proxy_http_version 1.1;

            proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
