events {}

http {

    include /etc/nginx/mime.types;

    default_type application/octet-stream;

    # DNS Docker. Адреса сервисов ищутся при запросе, а не при старте:
    # nginx поднимается, даже если tf-front / tf-auth / tf-bff ещё не запущены
    # (для них вернётся 502), и видит новый IP после пересоздания контейнера.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # WebSocket через прокси: Connection: upgrade только для запросов с Upgrade.
    map $http_upgrade $funnel_connection {
        default upgrade;
        ''      '';
    }


    # ==================================================
    # HTTP
    # ==================================================

    server {

        listen 80;

        # Сайт и поддомен Vault (VAULT_DOMAIN): проверка Let's Encrypt и редирект на HTTPS для всех имён.
        server_name ${HTTP_SERVER_NAMES};


        # Let's Encrypt ACME challenge
        location /.well-known/acme-challenge/ {

            root /var/www/certbot;
        }


        # Everything else -> HTTPS
        location / {

            return 301 https://$host$request_uri;
        }
    }


    # ==================================================
    # HTTPS
    # ==================================================

    server {

        listen 443 ssl;

        server_name ${SERVER_NAMES};


        # --------------------------------------------------
        # TLS
        # --------------------------------------------------

        ssl_certificate
            /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;

        ssl_certificate_key
            /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;

        ssl_session_cache shared:SSL:10m;

        ssl_session_timeout 10m;


        # --------------------------------------------------
        # Authentication
        #
        # /api/auth/*
        #       ↓
        # ${AUTH_HOST}:${AUTH_PORT}
        # --------------------------------------------------

        location /api/auth/ {

            # Адрес в переменной — разрешается при запросе (см. resolver).
            # С переменной proxy_pass не отрезает префикс сам, поэтому rewrite.
            set $auth_upstream http://${AUTH_HOST}:${AUTH_PORT};

            rewrite ^/api/auth/(.*)$ /$1 break;

            proxy_pass $auth_upstream;

            proxy_http_version 1.1;

            proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # --------------------------------------------------
        # BFF
        #
        # /api/bff/*
        #       ↓
        # ${BFF_HOST}:${BFF_PORT}
        # --------------------------------------------------

        location /api/bff/ {

            set $bff_upstream http://${BFF_HOST}:${BFF_PORT};

            rewrite ^/api/bff/(.*)$ /$1 break;

            proxy_pass $bff_upstream;

            proxy_http_version 1.1;

            proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # --------------------------------------------------
        # Окно «Логи» (tf-funnel)
        #
        # /api/funnel/log     — история показаний
        # /api/funnel/stream  — WebSocket живых показаний
        #       ↓
        # ${FUNNEL_HOST}:${FUNNEL_PORT}
        #
        # Остальное у воронки (приём шины, состояние каналов) наружу не открыто.
        # --------------------------------------------------

        location ~ ^/api/funnel/(log|stream)$ {

            set $funnel_upstream http://${FUNNEL_HOST}:${FUNNEL_PORT};

            rewrite ^/api/funnel/(.*)$ /$1 break;

            proxy_pass $funnel_upstream;

            proxy_http_version 1.1;

            # WebSocket /stream: без Upgrade nginx отдаст обычный HTTP, и браузер не подключится.
            proxy_set_header Upgrade $http_upgrade;

            proxy_set_header Connection $funnel_connection;

            proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_set_header X-Forwarded-Proto $scheme;

            # Окно «Логи» держит соединение часами; воронка шлёт ping раз в 30 с.
            proxy_read_timeout 1h;

            proxy_send_timeout 1h;

            proxy_buffering off;
        }

        # --------------------------------------------------
        # Frontend
        #
        # /*
        #       ↓
        # ${FRONTEND_HOST}:${FRONTEND_PORT}
        # --------------------------------------------------

        location / {

            set $frontend_upstream http://${FRONTEND_HOST}:${FRONTEND_PORT};

            proxy_pass $frontend_upstream;

            proxy_http_version 1.1;

            proxy_set_header Host $host;

            proxy_set_header X-Real-IP $remote_addr;

            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }


    # ==================================================
    # Дополнительные сайты: веб-интерфейс Vault (tf.d/vault.conf).
    # Файлы генерирует scripts/generate-nginx-config.sh по настройкам стенда.
    # ==================================================

    include /etc/nginx/tf.d/*.conf;
}
