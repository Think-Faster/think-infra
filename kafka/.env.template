# Скопировать в .env и заменить пароли.
# Пароли: только латиница и цифры (они подставляются в JAAS-строку в кавычках).

# Идентификатор кластера KRaft. Задаётся один раз до первого запуска и больше не меняется.
# Сгенерировать: docker run --rm apache/kafka:4.0.0 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=CHANGE_ME

TF_KAFKA_ADMIN_PASSWORD=PASSWORD
TF_KAFKA_FUNNEL_PASSWORD=PASSWORD
TF_KAFKA_MODEL_PASSWORD=PASSWORD
TF_KAFKA_BFF_PASSWORD=PASSWORD
